{
  "info": {
    "name": "Reservia - Dev 3 (Bookings, Tickets, Payments)",
    "description": "Local end-to-end flow for the Dev 3 modules. Requires dev-support/local-test-schema.sql and the database migration to have been applied. The x-user-id header is a development-only stand-in for the JWT auth module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create booking from active holds",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"seat_ids\": [1, 2]\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/bookings"
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('booking is created', function () { pm.response.to.have.status(201); });",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('bookingId', String(body.booking_id));",
          "pm.collectionVariables.set('ticketCode', body.ticket_codes[0]);",
          "pm.collectionVariables.set('bookingAmount', String(body.total_price));",
          "pm.test('one ticket code is returned per seat', function () { pm.expect(body.ticket_codes).to.have.length(2); });"
        ] } }
      ]
    },
    {
      "name": "2. List my bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/bookings?page=1&limit=10"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('booking list is returned', function () { pm.response.to.have.status(200); });",
        "pm.test('response contains a data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
      ] } }]
    },
    {
      "name": "3. Get booking details",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('booking details include its tickets', function () {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(pm.response.json().tickets).to.have.length(2);",
        "});"
      ] } }]
    },
    {
      "name": "4. Look up a ticket code",
      "request": { "method": "GET", "url": "{{baseUrl}}/tickets/{{ticketCode}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('ticket code can be looked up', function () {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get('ticketCode'));",
        "});"
      ] } }]
    },
    {
      "name": "5. Initiate mock payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/payments/{{bookingId}}/initiate"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('payment starts as pending', function () {",
        "  pm.response.to.have.status(201);",
        "  const body = pm.response.json();",
        "  pm.expect(body.status).to.eql('pending');",
        "  pm.collectionVariables.set('paymentId', String(body.payment_id));",
        "  pm.collectionVariables.set('paymentAmount', String(body.amount));",
        "});"
      ] } }]
    },
    {
      "name": "6. Simulate successful payment webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"payment_id\": {{paymentId}},\n  \"status\": \"completed\",\n  \"amount\": {{paymentAmount}}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/payments/webhook/mock"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('webhook confirms the payment', function () {",
        "  pm.response.to.have.status(201);",
        "  pm.expect(pm.response.json().status).to.eql('completed');",
        "});"
      ] } }]
    },
    {
      "name": "7. Check payment status",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/payments/{{paymentId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('payment is completed', function () {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(pm.response.json().status).to.eql('completed');",
        "});"
      ] } }]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "1" },
    { "key": "bookingId", "value": "" },
    { "key": "ticketCode", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "paymentAmount", "value": "" }
  ]
}
